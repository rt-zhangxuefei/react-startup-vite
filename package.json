{
  "name": "react-startup-vite",
  "version": "1.0.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "start": "vite",
    "build:beta": "vite build --mode beta",
    "build:prod": "vite build --mode prod",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write \"src/**/*.{js,jsx,ts,tsx,json,css,scss,less,md}\"",
    "type-check": "tsc --noEmit",
    "prepare": "husky"
  },
  "dependencies": {
    "@reduxjs/toolkit": "^2.12.0",
    "antd": "^6.6.5",
    "axios": "^1.20.0",
    "bytes": "^3.1.2",
    "classnames": "^2.5.1",
    "dayjs": "^1.11.23",
    "lodash-es": "^4.18.1",
    "nanoid": "^6.0.1",
    "react": "^19.3.0",
    "react-contextmenu-lite": "^1.0.13",
    "react-dom": "^19.3.0",
    "react-redux": "^9.3.0",
    "react-router": "^8.4.0",
    "redux-saga": "^1.5.1",
    "reselect": "^5.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "less": "^4.9.1",
    "lint-staged": "^17.5.1",
    "prettier": "^3.9.8",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0"
  },
  "lint-staged": {
    "src/**/*.{js,jsx,ts,tsx}": [
      "eslint --fix"
    ],
    "src/**/*.{js,jsx,ts,tsx,json,css,scss,less,md}": [
      "prettier --write"
    ]
  },
  "browserslist": [
    "defaults"
  ],
  "engines": {
    "node": ">=22.16.0"
  },
  "packageManager": "pnpm@11.13.1"
}
